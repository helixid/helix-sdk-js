{
  "name": "helix-sdk-js-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:non-live": "turbo run test:non-live",
    "test:unit": "pnpm --filter @helixid/did-hedera test:unit && pnpm --filter @helixid/sdk-js test:unit && pnpm --filter @helixid/mcp-middleware test:unit && pnpm --filter @helixid/langchain test:unit && pnpm --filter @helixid/cli test:unit && pnpm --filter @helixid/mcp-server test:unit && pnpm --filter @helixid/widget test:unit",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,json,md}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "protobufjs": "8.0.2"
    },
    "patchedDependencies": {
      "@changesets/cli@3.0.2": "patches/@changesets__cli@3.0.2.patch"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
