{
  "name": "@helixid/cli",
  "version": "0.1.1",
  "description": "Command-line interface for HelixID operator workflows \u2014 agent enrollment, bootstrap token management, wallet inspection, and credential lifecycle operations.",
  "type": "module",
  "bin": {
    "helix": "./dist/bin/helix.js"
  },
  "license": "Apache-2.0",
  "author": "DgVerse <hello@dgverse.in>",
  "homepage": "https://www.dgverse.in/products/helix-id",
  "repository": {
    "type": "git",
    "url": "https://github.com/helixid/helix-sdk-js",
    "directory": "cli"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/wallet": {
      "types": "./dist/lib/wallet.d.ts",
      "import": "./dist/lib/wallet.js"
    },
    "./lib/issuer-ops": {
      "types": "./dist/lib/issuer-ops.d.ts",
      "import": "./dist/lib/issuer-ops.js"
    },
    "./lib/duration": {
      "types": "./dist/lib/duration.d.ts",
      "import": "./dist/lib/duration.js"
    },
    "./lib/env": {
      "types": "./dist/lib/env.d.ts",
      "import": "./dist/lib/env.js"
    },
    "./core/keys": {
      "types": "./dist/core/keys.d.ts",
      "import": "./dist/core/keys.js"
    },
    "./core/did": {
      "types": "./dist/core/did.d.ts",
      "import": "./dist/core/did.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:non-live": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests --passWithNoTests",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helixid/sdk-js": "workspace:^",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "zod": "^3.23.0",
    "chalk": "^5.4.1",
    "commander": "^11.1.0"
  },
  "optionalDependencies": {
    "@helixid/did-hedera": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
