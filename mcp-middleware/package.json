{
  "name": "@helixid/mcp-middleware",
  "version": "0.4.0",
  "description": "HelixID middleware for Model Context Protocol (MCP) servers: in-process KYA-OS request-proof and delegation-chain verification with scope enforcement, sessions, replay store and response proofs.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "DgVerse <hello@dgverse.in>",
  "homepage": "https://helixid.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/helixid/helix-sdk-js",
    "directory": "mcp-middleware"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "test:non-live": "vitest run --passWithNoTests",
    "test:unit": "vitest run tests --passWithNoTests",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@helixid/sdk-js": "workspace:^"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*",
    "ioredis": "^5.0.0 || ^6.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ioredis": "6.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
