# order-management sample: copy to .env and fill in. See README.md and src/main.ts for every variable.

PORT=3700
HOST=127.0.0.1
# MCP_RESOURCE=http://localhost:3700/mcp

# HelixID VPs and audit
# HELIX_API_URL=http://localhost:3000
# HELIX_API_KEY=
# SERVICE_DID=did:web:orders.example.com

# OAuth: one issuer, several (OAUTH_ISSUERS, JSON), or the local demo tokens
# OAUTH_ISSUER=https://your-tenant.example.com/
DEMO_MODE=1

# KYA-OS session and response proof (story L2-A): the key SERVICE_DID's document lists as key-1.
# SERVICE_SIGNING_KEY=
# KYAOS_PUBLIC_ORIGIN=https://orders.example.com
# KYAOS_CLOCK_SKEW_SECONDS=120
# KYAOS_SESSIONS=1
# KYAOS_SESSION_TTL_MINUTES=30

# The replay store, read by @helixid/mcp-middleware (nonceStoreFromEnv).
# memory (default): this process only. redis or dynamo: shared by every instance serving this DID.
# KYAOS_NONCE_STORE=memory
# redis needs the ioredis package (npm install ioredis):
# KYAOS_NONCE_STORE=redis
# KYAOS_REDIS_URL=redis://127.0.0.1:6379
# KYAOS_NONCE_KEY_PREFIX=kyaos:nonce:
# dynamo needs @aws-sdk/client-dynamodb and @aws-sdk/lib-dynamodb; AWS credentials come from the SDK's own chain:
# KYAOS_NONCE_STORE=dynamo
# KYAOS_DYNAMO_TABLE=kyaos-nonces
# KYAOS_DYNAMO_KEY_ATTRIBUTE=pk
# KYAOS_DYNAMO_TTL_ATTRIBUTE=expiresAt
# KYAOS_DYNAMO_REGION=eu-west-1
# KYAOS_DYNAMO_ENDPOINT=http://127.0.0.1:8000
